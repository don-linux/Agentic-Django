# Django
# Copy this file to .env (repo root). docker/dev/compose.yaml injects it into the
# Django, worker and Postgres containers, and config.settings.local reads it when
# Django runs on your machine (a variable already exported in the shell wins). A
# second file, docker/dev/.env (from docker/dev/.env.example), holds published ports
# and PROJECT_NAME; both are required, including for the devcontainer.

DJANGO_DEBUG=True
# Display and date-boundary zone (data is stored in UTC). Example: America/Mexico_City
DJANGO_TIME_ZONE=UTC
# Unset: config/settings/local.py uses its django-insecure- development key.
# DJANGO_SECRET_KEY=

POSTGRES_DB=project_db
# Same role name as docker/prod/.env.example (django). Local-only password.
POSTGRES_USER=django
POSTGRES_PASSWORD=password123

# Values for Django on your machine (docs/development/without-docker.md);
# docker/dev/compose.yaml overrides them inside the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Mailpit catches every email. Inbox at http://localhost:8025
DJANGO_MAILER_HOST=localhost
DJANGO_MAILER_PORT=1025
# Valkey (cache). The scheme stays redis:// (rediss:// for TLS): it is the wire
# protocol, and no client accepts valkey://. Never put credentials in the URL.
VALKEY_URL=redis://localhost:6379
# Cache and broker use logical databases 0 and 1 by default (VALKEY_CACHE_DB /
# VALKEY_BROKER_DB); do not put a /0 in the URL.

# Frontend base URL used in headless allauth notification links
FRONTEND_URL=http://localhost:3000

# Browser frontend origin; must be listed or the SPA cannot call /api/ or /_allauth/.
# Empty denies every cross-origin caller.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Display name in the account-email signature (templates/account/email/base_message.txt).
DJANGO_EMAIL_SIGNATURE_NAME="Project"
# DJANGO_EMAIL_SUBJECT_PREFIX="[Project] "
# DJANGO_DEFAULT_FROM_EMAIL="Project <noreply@example.com>"

# Deepest page a page-number list serves (deeper pages are a 404)
# DJANGO_API_MAX_PAGE_NUMBER=1000

# Print every SQL query in the runserver console
# DJANGO_LOG_SQL=True

# Log lines: text (default here) or json (one object per line, as in production)
# DJANGO_LOG_FORMAT=json
