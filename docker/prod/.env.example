# Copy to docker/prod/.env. Compose reads it for the variables below and passes it to django.
#
# Legend: Required = uncommented, must be replaced before `up`. Optional = commented,
# or the Sentry / S3 blocks. The container refuses to start until every change-me,
# every example.com / example.org / example.net, and every empty Required value is
# replaced. .invalid / .test hosts are for CI and tests only, never for a real deploy.

# Compose
# Required: compose project name and the uploads path (must exist on the host).
PROJECT_NAME=project-name
# Docker publishes ports past the host firewall: keep 127.0.0.1 and put the TLS proxy in front.
# Never 0.0.0.0 or a public address: Django trusts X-Forwarded-Proto and X-Forwarded-For
# from whoever reaches Gunicorn, so clients could fake HTTPS and their IP (docs/deploy.md#proxy).
DOCKER_PROD_DJANGO_BIND=127.0.0.1
DOCKER_PROD_DJANGO_PORT=8000
# Uploads folder on the host: an absolute path outside the repo, so a `git clean -fdx` or a
# fresh clone never touches it. Create it and give it to UID 1000 before the first `up`:
#   sudo mkdir -p /srv/project-name/uploads/{public,private} && sudo chown -R 1000:1000 /srv/project-name/uploads
# 1000:1000 is the container user; another owner needs a rebuild with:
# DOCKER_PROD_USER_UID=1000
# DOCKER_PROD_USER_GID=1000
# Compose refuses to start if it does not exist. The proxy serves uploads/public at /media/;
# uploads/private is reachable only through Django (X-Accel-Redirect to /protected-media/).
DOCKER_PROD_DJANGO_UPLOADS_PATH=/srv/project-name/uploads
DOCKER_PROD_DJANGO_GUNICORN_WORKERS=3
DOCKER_PROD_DJANGO_GUNICORN_THREADS=3
# Seconds before gunicorn restarts a worker that stopped responding. With threads it is a
# heartbeat, not a request limit: PostgreSQL's statement timeout bounds each query.
# DOCKER_PROD_DJANGO_GUNICORN_TIMEOUT=30
# Seconds in-flight requests get after SIGTERM; keep it below stop_grace_period (30s).
# DOCKER_PROD_DJANGO_GUNICORN_GRACEFUL_TIMEOUT=25
# Sizing workers, threads and Argon2 for the server's RAM: docs/deploy.md#capacity.
# Container memory limit. It must exceed the capacity peak in docs/deploy.md#capacity plus the 256m
# /tmp tmpfs; on small servers lower DJANGO_ARGON2_MEMORY_COST_KIB instead of this limit.
DOCKER_PROD_DJANGO_MEM_LIMIT=1536m

# Django
# Log lines: json (one object per line, the production default) or text.
DJANGO_LOG_FORMAT=json
# Stamp the image, Sentry, and JSON logs with the deployed commit. Prefer passing
# it on the build command (so .env does not go stale):
#   APP_RELEASE=$(git rev-parse --short HEAD) docker compose -f docker/prod/compose.yaml up -d --build
# Optional:
# APP_RELEASE=
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required: replace every change-me and every example.com / example.org / example.net.
DJANGO_SECRET_KEY=change-me
# While rotating: the previous key(s), comma separated. See docs/security.md.
# DJANGO_SECRET_KEY_FALLBACKS=
# Required: hard to guess, with a trailing slash
DJANGO_ADMIN_URL=change-me/
# Required: the API host. Not *, not example.com, not localhost.
DJANGO_ALLOWED_HOSTS=example.com
# Display and date-boundary zone (data is stored in UTC). Example: America/Mexico_City
DJANGO_TIME_ZONE=UTC
# Required for a browser frontend: its origin (the browser's Origin), not the API
# host. Often the same value as FRONTEND_URL and CORS_ALLOWED_ORIGINS. Empty suits
# token-only or same-origin clients.
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# URL prefix of public uploads; the nginx in docs/NEXT-STEPS.md serves /media/.
# DJANGO_MEDIA_URL=/media/

# Security
# The proxy must send X-Forwarded-Proto: https, or every request redirects in a loop.
DJANGO_SECURE_SSL_REDIRECT=True
# Raise to 31536000 (1 year) once HTTPS works on every host, before enabling subdomains and preload.
DJANGO_SECURE_HSTS_SECONDS=60
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# Send X-Content-Type-Options: nosniff; leave it on.
# DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
# Failed admin logins before the lockout (docs/security.md#admin-lockout).
# AXES_FAILURE_LIMIT=5

# PostgreSQL
# Required: database name, role, and password (never leave the password empty).
POSTGRES_DB=project_db
POSTGRES_USER=django
POSTGRES_PASSWORD=change-me
# A database outside this compose file: one URL instead of the POSTGRES_* values.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# Seconds a persistent connection is reused (0 = a new connection per request).
# CONN_MAX_AGE=60
# Check a persistent connection before reusing it (recovers after a Postgres restart).
# CONN_HEALTH_CHECKS=True
# Seconds to wait for a connection before failing (and /health/ returning 503).
# POSTGRES_CONNECT_TIMEOUT=5
# Server-side limits for requests, in milliseconds (0 = no limit).
# POSTGRES_STATEMENT_TIMEOUT_MS=30000
# POSTGRES_LOCK_TIMEOUT_MS=0
# Lock timeout for `migrate` on startup, in milliseconds (it runs without a statement timeout).
# DJANGO_MIGRATE_LOCK_TIMEOUT_MS=10000
# Statements slower than this (ms) go to the PostgreSQL log; -1 turns the log off.
# POSTGRES_LOG_MIN_DURATION_MS=500
# Memory: shared_buffers about 25% of the server's RAM, effective_cache_size about 50-75%.
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
# Per sort or hash step of each query, so keep it small.
# POSTGRES_WORK_MEM=4MB
# Apply migrations on every start (docker/prod/migrate.sh). Set to false with more
# than one django replica, and run migrate.sh once per deploy (docs/deploy.md#migrate).
DJANGO_MIGRATE_ON_START=true

# Valkey (cache)
# Required: the password of the valkey service (at least 32 characters). It never goes inside VALKEY_URL.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VALKEY_PASSWORD=change-me
# Only for a Valkey outside this compose file (a managed one): its URL, without
# credentials and without a database number. rediss:// turns TLS on and must end
# with ?ssl_cert_reqs=required: without it the Celery broker would connect without
# verifying the certificate, so production refuses to start (the cache always
# verifies). Do not add ssl_check_hostname=false: production also refuses that.
# The scheme is never valkey://: redis:// is the wire protocol.
# VALKEY_URL=rediss://<host>:6380?ssl_cert_reqs=required
# Memory Valkey may use before it evicts cache entries, and the limit of its container
# (about twice as much: rewriting the append-only file forks the process).
# VALKEY_MAXMEMORY=256mb
# DOCKER_PROD_VALKEY_MEM_LIMIT=512m
# Seconds to wait for a connection and for each reply. Short on purpose: a stalled
# Valkey must not hold a gunicorn thread.
# VALKEY_CONNECT_TIMEOUT=1
# VALKEY_SOCKET_TIMEOUT=1
# Default lifetime of a cache entry, and the lifetime given to a key written without
# one (Valkey only evicts keys that expire), in seconds.
# DJANGO_CACHE_TIMEOUT=300
# VALKEY_MAX_TTL=2592000
# Prefix of every cache key. It defaults to the project slug (config/settings/base.py).
# DJANGO_CACHE_KEY_PREFIX=
# Raise it to drop every cached entry after a change of format. Never tie it to
# APP_RELEASE: each deploy would reset throttles and rate limits.
# DJANGO_CACHE_VERSION=1
# Logical databases of the cache and of the task broker. They must differ.
# VALKEY_CACHE_DB=0
# VALKEY_BROKER_DB=1
# ACL user, only when the server defines one (a managed Valkey).
# VALKEY_USERNAME=

# Background tasks (Celery)
# Seconds a task may run. The soft limit raises SoftTimeLimitExceeded inside the task,
# the hard one kills its process. Keep soft < hard < 3600 (the broker redelivers a
# message that is not acknowledged within an hour).
# CELERY_TASK_SOFT_TIME_LIMIT=1500
# CELERY_TASK_TIME_LIMIT=1800
# Worker processes, and when one is replaced: after this many tasks, or once it holds
# this much memory (KiB).
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_MAX_TASKS_PER_CHILD=100
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000
# Only when the broker is not this Valkey: its full URL. It then carries its own
# credentials, so it is a secret. By default the URL is built from VALKEY_URL,
# VALKEY_PASSWORD and VALKEY_BROKER_DB. With rediss:// it also needs
# ?ssl_cert_reqs=required.
# CELERY_BROKER_URL=
# The celery_worker container: its memory limit, and Docker's stop grace period.
# On stop, running tasks get 20 s (CELERY_WORKER_SOFT_SHUTDOWN_TIMEOUT) and then go
# back to the queue; keep the grace period longer than that.
# DOCKER_PROD_CELERY_WORKER_MEM_LIMIT=768m
# DOCKER_PROD_CELERY_WORKER_STOP_GRACE_PERIOD=60s
# CELERY_WORKER_LOG_LEVEL=INFO
# Statement timeout of the worker's database connections, in milliseconds. Requests keep
# POSTGRES_STATEMENT_TIMEOUT_MS. Never 0.
# CELERY_POSTGRES_STATEMENT_TIMEOUT_MS=300000

# Email
# Required: an address on a domain verified with your email provider.
DJANGO_DEFAULT_FROM_EMAIL="Project <noreply@example.com>"
# Display name in the account-email signature (templates/account/email/base_message.txt).
DJANGO_EMAIL_SIGNATURE_NAME="Project"
# Defaults to DJANGO_DEFAULT_FROM_EMAIL. The defaults live in config/settings/base.py.
# DJANGO_SERVER_EMAIL=
# Who gets error emails: comma separated addresses. With a name, single-quote the whole
# value for Compose: DJANGO_ADMINS='"Ops" <ops@example.com>' (no commas in names).
# Empty: no error emails. They are also skipped while SENTRY_DSN is set.
# DJANGO_ADMINS=admin@example.com
# Quoted: Compose strips trailing spaces, and the space separates the prefix from the subject.
# DJANGO_EMAIL_SUBJECT_PREFIX="[Project] "
# Seconds per SMTP operation (a hanging provider holds the request this long).
# DJANGO_MAILER_TIMEOUT=10
# DJANGO_MAILER_* map to MAILERS["default"]["OPTIONS"] in config/settings/production.py
# Required: your provider's SMTP host (see docs/email.md). For a relay on the host, use
# host.docker.internal and give the django, celery_worker and celery_beat services
# extra_hosts: ["host.docker.internal:host-gateway"]. Not localhost: that is the container.
DJANGO_MAILER_HOST=
DJANGO_MAILER_PORT=587
DJANGO_MAILER_USERNAME=
DJANGO_MAILER_PASSWORD=
DJANGO_MAILER_USE_TLS=True
DJANGO_MAILER_USE_SSL=False
# Provider values (SES, Postmark, Resend, Brevo, Mailgun), DNS and a checklist: docs/email.md.
# Port 465 instead of 587: DJANGO_MAILER_PORT=465, DJANGO_MAILER_USE_TLS=False and DJANGO_MAILER_USE_SSL=True.
# Gmail only suits a prototype (app password, low daily limit; see docs/email.md).
# Try it: docker compose exec django python manage.py sendtestemail you@example.com

# Passwords (Argon2)
# Each concurrent password hash allocates MEMORY_COST_KIB. OWASP minimum: 19456 KiB,
# time cost 2, parallelism 1. Django default: 102400 KiB, 2, 8. Existing hashes are
# upgraded on the next login after a change.
# DJANGO_ARGON2_TIME_COST=2
# DJANGO_ARGON2_MEMORY_COST_KIB=102400
# DJANGO_ARGON2_PARALLELISM=8

# Proxies and throttling
# Number of reverse proxies in front of gunicorn that append to X-Forwarded-For (nginx alone: 1).
# Used by allauth rate limits and API throttling. A wrong value lets clients forge their IP
# (too high) or puts every client in one bucket (too low).
DJANGO_TRUSTED_PROXY_COUNT=1
# Older name of DJANGO_TRUSTED_PROXY_COUNT, read only when that one is unset.
# ALLAUTH_TRUSTED_PROXY_COUNT=1
# Deepest page a page-number list serves (each page runs COUNT plus OFFSET; deeper is a 404).
# DJANGO_API_MAX_PAGE_NUMBER=1000
# API limits per client IP (anonymous) and per user. A starting point: tune per project.
# DJANGO_THROTTLE_ANON_RATE=60/min
# DJANGO_THROTTLE_USER_RATE=600/min

# django-allauth
# Open registration (the template default). Set False to disable signup.
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
# Required: frontend base URL used in headless allauth email links (existing account, unknown password reset).
FRONTEND_URL=https://app.example.com
# Required for a browser frontend: the SPA origin. Empty denies every cross-origin caller.
# Must be listed or the SPA cannot call /api/ or /_allauth/. https only, no path; production
# refuses example.com and localhost here.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Object storage (optional)
# Uploads in an S3 or S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces,
# Backblaze B2, MinIO, Hetzner) instead of the uploads folder. The image needs the s3
# extra; docs/files.md has the bucket policy (only public/ may be readable).
# DOCKER_PROD_UV_EXTRAS=s3
# DJANGO_STORAGE_BACKEND=s3
# DJANGO_AWS_STORAGE_BUCKET_NAME=
# DJANGO_AWS_S3_REGION_NAME=
# Non-AWS providers: their endpoint, e.g. https://<account>.r2.cloudflarestorage.com
# DJANGO_AWS_S3_ENDPOINT_URL=
# Public files through a CDN or custom domain (optional)
# DJANGO_AWS_S3_CUSTOM_DOMAIN=
# Seconds a signed URL for a private file stays valid
# DJANGO_AWS_QUERYSTRING_EXPIRE=300
# Read by boto3, never by Django settings
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Sentry error tracking (optional): an empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
