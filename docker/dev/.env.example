# Copy to docker/dev/.env (Compose interpolation only: project name and published ports).
# Django, Postgres, Mailpit and Valkey settings live in the repo-root .env
# (from .env.example). Both files are required, including for the devcontainer.
DOCKER_DEV_DJANGO_PORT=8000
DOCKER_DEV_POSTGRES_DB_PORT=5432
DOCKER_DEV_MAILPIT_UI_PORT=8025
DOCKER_DEV_MAILPIT_SMTP_PORT=1025
DOCKER_DEV_VALKEY_PORT=6379
PROJECT_NAME=project-name
# The dev container runs as a user with this UID and GID, so the files it writes
# to the checkout are yours. On Linux set them to `id -u` and `id -g`, then
# rebuild (up --build).
HOST_UID=1000
HOST_GID=1000
# Host already has Postgres or Valkey/Redis: change the published ports, e.g.
# DOCKER_DEV_POSTGRES_DB_PORT=5433
# DOCKER_DEV_VALKEY_PORT=6380
